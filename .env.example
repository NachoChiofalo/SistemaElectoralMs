# ===================== ENTORNO =====================
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# ===================== BASE DE DATOS (Supabase) =====================
# Cadena de conexion de Supabase. Se recomienda el POOLER (puerto 6543) sobre la
# conexion directa (5432): tolera mejor que el proceso se reinicie.
#   Supabase > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Alternativa para desarrollo sin conexion (docker compose --profile local).
# Solo se usan si DATABASE_URL esta vacio.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_electoral
DB_USER=electoral_user
DB_PASSWORD=electoral_password

# Un unico pool para todo el proceso. 8 cubre el trafico real con margen; subirlo sin
# necesidad solo consume cupo de conexiones de Supabase.
DB_POOL_MAX=8
DB_STATEMENT_TIMEOUT_MS=20000

# ===================== SESIONES =====================
# Obligatorio. Minimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=2h
REFRESH_TOKEN_EXPIRATION=7d
INACTIVITY_TIMEOUT_MINUTES=30

# Cuanto vive una sesion verificada en la cache antes de revalidar contra la base.
SESSION_CACHE_TTL_MS=30000
# Cada cuanto, como maximo, se persiste last_activity de un usuario.
ACTIVITY_WRITE_INTERVAL_MS=60000

# ===================== HTTP =====================
FRONTEND_URL=http://localhost:8080
# Cantidad de proxies por delante (Render: 1). Afecta como se resuelve la IP del cliente.
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ===================== ALTA DEL ADMINISTRADOR =====================
# Solo los lee scripts/seed-usuarios.js. Si no se define ADMIN_PASSWORD, el script
# genera una y la muestra una unica vez.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@electoral.gov.ar
