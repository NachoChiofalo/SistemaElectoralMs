{
  "name": "sistema-electoral",
  "version": "2.0.0",
  "description": "Sistema Electoral - monolito modular (padron, autenticacion y resultados)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:adopt": "node scripts/migrate.js adopt",
    "snapshot": "node scripts/api-snapshot.js",
    "build:assets": "node scripts/build-assets.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed:usuarios": "node scripts/seed-usuarios.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.6"
  },
  "keywords": [
    "electoral",
    "padron",
    "monolito-modular"
  ],
  "author": "Sistema Electoral",
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.20",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "lucide-static": "^0.454.0"
  }
}
